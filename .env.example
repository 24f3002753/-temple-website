# Flask Environment
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://temple_admin:temple_secure_pass@localhost:5432/temple_trust_db

# Razorpay Configuration (Get these from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretKeyHere

# SMTP / Email Configuration for Receipts
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=trust.temple@gmail.com
MAIL_PASSWORD=your_app_specific_password_here
MAIL_DEFAULT_SENDER="श्री देवस्थान विश्वस्त व्यवस्था" <trust.temple@gmail.com>

# File Upload & Media Storage
UPLOAD_FOLDER=app/static/uploads
RECEIPT_FOLDER=app/static/receipts
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size
